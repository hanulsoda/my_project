# Copy to .env (git-ignored) and edit. Never commit the real .env.
# Sign-in comes from the Dahim (academy) site; see docs/sso.md.
# SSO_SECRET: the same value as DAHIM_READING_SECRET on the academy site, at least 32 characters,
# e.g. `openssl rand -hex 32`. Unset, too short, or still "change-me...": /sso is off (503).
SSO_SECRET=change-me-to-the-output-of-openssl-rand-hex-32
# Where the "다힘 사이트로 가기" buttons and logout send people.
ACADEMY_URL=https://dahim.kr/
# Break-glass only: 1 turns the old password login, invites and reset links back on. Keep 0.
ALLOW_PASSWORD_LOGIN=0
# Used only with ALLOW_PASSWORD_LOGIN=1, and only while the database has no users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase
DB_PATH=/app/data/db/app.db
NODE_ENV=production
